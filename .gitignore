# =============================================================================
# Mindello — .gitignore
# =============================================================================


# =============================================================================
# SECRETS & ENVIRONMENT VARIABLES
# Never commit credentials, API keys, or secret settings.
# =============================================================================
.env
.env.*
.env.local
.env.development
.env.production
.env.staging
*.secret
secrets.json
credentials.json
service_account.json
local_settings.py
django_app/mindello/local_settings.py


# =============================================================================
# PYTHON
# =============================================================================
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
*.pyc

# Virtual environments
venv/
env/
.venv/
.env/
ENV/
venv.bak/

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg
.eggs/
wheels/
pip-wheel-metadata/
MANIFEST

# Unit test / coverage
.coverage
.coverage.*
coverage.xml
*.cover
htmlcov/
.pytest_cache/
.tox/
nosetests.xml

# Jupyter Notebook checkpoints and outputs
.ipynb_checkpoints/
*.ipynb_checkpoints

# pyenv
.python-version

# mypy / type checkers
.mypy_cache/
.dmypy.json
dmypy.json
.pyright/

# Profiling
*.prof


# =============================================================================
# DJANGO
# =============================================================================

# SQLite databases — use PostgreSQL in production; never commit local DB
*.sqlite3
*.sqlite3-journal
db.sqlite3
db.sqlite3-wal
db.sqlite3-shm

# Django collected static files (regenerated by collectstatic)
django_app/staticfiles/
staticfiles/

# Django media uploads (user-uploaded content — belongs in cloud storage)
django_app/media/
media/

# Django migrations — commit these; ignore only compiled cache
# (do NOT add migrations/ here — they must be tracked)

# Django secret key file if externalised
secret_key.txt


# =============================================================================
# MACHINE LEARNING MODELS
# Large binary artifacts — store in DVC, Git LFS, or S3, not in git history.
# =============================================================================

# Trained model artifacts
ml_models/*.pkl
ml_models/*.joblib
ml_models/*.h5
ml_models/*.pt
ml_models/*.pth
ml_models/*.onnx
ml_models/*.bin
ml_models/*.model

# Keep Python source files in ml_models/
!ml_models/*.py
!ml_models/__init__.py

# Explainer cache / background data
ml_models/background_data.pkl
ml_models/shap_values_cache/

# Experiment tracking
mlruns/
.mlflow/
wandb/
runs/


# =============================================================================
# DATA
# Raw datasets may be large or contain PII — do not commit.
# =============================================================================

# Raw data files
data/*.csv
data/*.tsv
data/*.xlsx
data/*.xls
data/*.json
data/*.parquet
data/*.feather
data/*.h5

# Keep the data directory itself (with a .gitkeep if needed)
!data/.gitkeep
!data/README.md

# Processed / intermediate data
data/processed/
data/interim/
data/external/


# =============================================================================
# NODE / REACT FRONTEND
# =============================================================================

# Dependencies (installed via npm install)
node_modules/
frontend/node_modules/

# Production build output (regenerated by npm run build)
frontend/dist/
dist/

# Vite cache
frontend/.vite/
.vite/

# npm / yarn / pnpm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
package-lock.json.bak

# Local env overrides for Vite
frontend/.env
frontend/.env.*
frontend/.env.local


# =============================================================================
# EDITORS & IDEs
# =============================================================================

# VSCode
.vscode/
*.code-workspace

# JetBrains (PyCharm, WebStorm, etc.)
.idea/
*.iml
*.iws
*.ipr

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim / Neovim
*.swp
*.swo
*~
.netrwhist

# Emacs
*#
.#*

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk


# =============================================================================
# LOGS & TEMPORARY FILES
# =============================================================================
*.log
*.log.*
logs/
log/
*.tmp
*.temp
*.bak
*.orig
*.pid


# =============================================================================
# TESTING & CI
# =============================================================================
.coverage
coverage/
htmlcov/
test-results/
junit.xml
test_output/


# =============================================================================
# DOCKER (if added later)
# =============================================================================
.dockerignore.local
docker-compose.override.yml
docker-compose.local.yml


# =============================================================================
# MISCELLANEOUS
# =============================================================================

# OS-generated thumbnails and index files
.directory

# Compressed archives (unlikely to belong in source control)
*.zip
*.tar.gz
*.tar.bz2
*.rar
*.7z

# Certificate files
*.pem
*.key
*.crt
*.cert
*.p12
*.pfx
